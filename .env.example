# Resend (server-only — never prefix with VITE_)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=MySWYM <noreply@myswym.app>
EMAIL_REPLY_TO=contact@myswym.app
# Optional — inbox for /api/contact (defaults to EMAIL_REPLY_TO)
# EMAIL_CONTACT_TO=contact@myswym.app

# Protects POST /api/email/send (header: x-myswym-email-secret)
INTERNAL_EMAIL_SECRET=change-me-to-a-long-random-string

# Public site URL (Edge Functions → Vercel email API)
# APP_URL=https://myswym.app

# Stripe Checkout (IDs publics — jamais le secret en VITE_)
# Front (Vite) :
# VITE_STRIPE_PRICE_MONTHLY_FLEX=price_...     # 9,99 € / mois sans engagement
# VITE_STRIPE_PRICE_MONTHLY_COMMIT=price_...   # 4,99 € / mois engagement 12 mois
# VITE_STRIPE_PRICE_ANNUAL=price_...           # 52,99 € / an en 1 fois
# Edge Functions (supabase secrets set) :
# STRIPE_PRICE_MONTHLY_FLEX / STRIPE_PRICE_MONTHLY_COMMIT / STRIPE_PRICE_ANNUAL
# Alias legacy : STRIPE_PRICE_MONTHLY = mensuel 12 mois (4,99 €)

# Also set these as Supabase Edge Function secrets (for stripe-webhook emails):
#   supabase secrets set APP_URL=https://myswym.app
#   supabase secrets set INTERNAL_EMAIL_SECRET=same-as-vercel
#   supabase secrets set RESEND_API_KEY=re_...
#
# Trial drip (J1/J3/J6) — one-shot setup against Resend:
#   npm run email:setup-trial-drip
# Trial J-1 filet — GitHub Action .github/workflows/marketing-cron.yml
#   needs repo secrets SUPABASE_URL + INTERNAL_EMAIL_SECRET

# PostHog product analytics (client — VITE_PUBLIC_*)
# Project settings → Project API Key + Host (EU: https://eu.i.posthog.com)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Arthur AI (server-only — never VITE_OPENAI_*) ──────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Optional: mock OpenAI for local tests (npm run test:arthur)
# ARTHUR_AI_MOCK=1
# Optional: internal test auth for POST /api/ai/chat (header x-myswym-arthur-secret)
# ARTHUR_AI_INTERNAL_SECRET=change-me-long-random

# Supabase admin for Arthur AI (Vercel serverless)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# (fallback clients also accept VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY)

# ── Instagram / Meta (Arthur AI Phase E — server only) ─────────────────────
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=long-random-verify-token
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ID=   # optional; default "me"
# META_GRAPH_VERSION=v21.0
# ARTHUR_META_SKIP_SIGNATURE=1  # TEMP Shadow only: accept Meta POST even if HMAC fails (remove ASAP)
# Mock local (skip Meta send + soft verify):
# INSTAGRAM_MOCK=1
# Test mock webhook: POST /api/instagram/mock
#   header x-myswym-instagram-mock: $ARTHUR_AI_INTERNAL_SECRET
#   body: { "senderId":"ig_xxx", "text":"PLAN triathlon", "referral": { "reel_id":"...", "campaign":"..." } }

# Local Vite → APIs staging (npm run dev). Override si tu lances `vercel dev` :
# DEV_API_ORIGIN=https://staging.myswym.app
# DEV_API_BYPASS_SECRET=   # si staging a la protection Vercel

# ── Arthur Growth / Conversion admin (server only) ─────────────────────────
# ARTHUR_ADMIN_SECRET=change-me-long-random
# ARTHUR_ADMIN_EMAILS=admin@myswym.app
# Portail : /admin  (email admin@myswym.app + mot de passe = ARTHUR_ADMIN_SECRET)
# Anciennes URLs : /admin/arthur-growth  /admin/arthur-followups  /admin/arthur-optimize  /admin/arthur-readiness  /admin/arthur-shadow
#
# Phase F2 — envois de relances Instagram (OFF par défaut) :
# ARTHUR_FOLLOWUPS_SEND=1          # requis pour tout envoi (après validation)
# ARTHUR_FOLLOWUPS_SEND_MOCK=1     # force mock même si SEND=1 (recommandé d’abord)
# Phase F3 — Optimization Loop : pas d’envoi auto ; mesure qualité/CTA uniquement.
#
# Phase G — Production readiness :
# ARTHUR_FLAG_ENABLED=1
# ARTHUR_FLAG_WEB=1
# ARTHUR_FLAG_INSTAGRAM=1
# ARTHUR_FLAG_TOOLS_WRITE=1
# ARTHUR_FLAG_OPTIMIZATION=1
# ARTHUR_FLAG_OFFLINE=0
# ARTHUR_FLAG_HUMAN_TAKEOVER_ALL=0
# ARTHUR_RATE_PER_HOUR=40
# ARTHUR_RATE_PER_DAY=200
# ARTHUR_COST_BUDGET_DAY_USD=25
# ARTHUR_COST_BUDGET_MONTH_USD=400
# ARTHUR_COST_SOFT_RATIO=0.8
#
# Phase H1 — Shadow Mode Instagram (défaut ON = pas d’envoi DM auto) :
# ARTHUR_FLAG_SHADOW_INSTAGRAM=1
# ARTHUR_INSTAGRAM_LIVE_SEND=   # ne pas mettre à 1 sans validation explicite
# Dashboard: /admin/arthur-shadow

# Soft-branch catalogue Google Sheet (local). 1 = on ; omettre ou 0 = off hors DEV.
# VITE_NATATION_SHEET_CATALOGUE=0  # kill-switch (défaut navigateur = ON pour vague 1 Nager)
# NATATION_SHEET_ID=  # ID du classeur cahier natation (onglets séances + Éducatifs)

# Client build (Vite) — bump when shipping a new frontend:
# VITE_APP_VERSION=1.0.0
# Server (Vercel env) — raise to force all older clients to update:
# MIN_SUPPORTED_APP_VERSION=1.0.0
# LATEST_APP_VERSION=1.0.0
# Optional copy on the blocking screen:
# FORCE_UPDATE_MESSAGE=Une nouvelle version de MySWYM est disponible.

# ── Telegram ──────────────────────────────────────────────────────────────
# Bot support nageur (bulle in-app, webhook obligatoire) :
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OPERATOR_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# Webhook : https://www.myswym.app/api/telegram/webhook  (pas l’apex, 307)
#
# Bot contact landing (envoi seul, pas de webhook). Créer un 2e bot BotFather,
# lui envoyer /start, coller le token. Le chat id perso est souvent le même.
# TELEGRAM_CONTACT_BOT_TOKEN=
# TELEGRAM_CONTACT_CHAT_ID=   # optionnel ; défaut = TELEGRAM_OPERATOR_CHAT_ID
