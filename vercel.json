{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/app-version",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.myswym.app" }],
      "destination": "https://myswym.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.myswym.app" }],
      "destination": "https://myswym.app/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "auth", "value": "login" }],
      "destination": "/connexion",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "auth", "value": "register" }],
      "destination": "/inscription",
      "permanent": false
    },
    {
      "source": "/accueil",
      "has": [{ "type": "query", "key": "auth", "value": "login" }],
      "destination": "/connexion",
      "permanent": false
    },
    {
      "source": "/accueil",
      "has": [{ "type": "query", "key": "auth", "value": "register" }],
      "destination": "/inscription",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "query", "key": "auth", "value": "login" }],
      "destination": "/connexion",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "query", "key": "auth", "value": "register" }],
      "destination": "/inscription",
      "permanent": false
    },
    { "source": "/accueil", "destination": "/", "permanent": true },
    { "source": "/homepage", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "/connexion", "permanent": true },
    { "source": "/register", "destination": "/inscription", "permanent": true },
    { "source": "/comment-ca-marche", "destination": "/?s=how", "permanent": true },
    { "source": "/objectifs", "destination": "/?s=pourquoi", "permanent": true },
    { "source": "/conformite", "destination": "/?s=seance", "permanent": true }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/((?!api|assets|favicon).*)", "destination": "/index.html" }
  ]
}
